{
  "name": "ai-customer-support-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Internal knowledge-grounded customer support assistant",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "nx serve web",
    "dev": "nx serve web",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:legacy": "node --test tests/app.test.js tests/http.test.js",
    "db:migrate": "node apps/api/scripts/typeorm-cli.cjs -d apps/api/src/database/data-source.ts migration:run",
    "db:revert": "node apps/api/scripts/typeorm-cli.cjs -d apps/api/src/database/data-source.ts migration:revert",
    "admin:create": "ts-node -P apps/api/tsconfig.app.json --transpile-only apps/api/src/cli/bootstrap-admin.ts",
    "legacy:setup": "node scripts/setup.js",
    "legacy:start": "node src/index.js",
    "legacy:dev": "node --watch src/index.js"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@inquirer/prompts": "8.7.3",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-parse": "1.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@schematics/angular": "22.2.3",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "nx": "23.3.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.2",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.0.8",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "nx": {
    "includedScripts": []
  },
  "packageManager": "npm@11.19.0"
}
